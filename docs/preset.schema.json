{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morph Lab preset v1",
  "type": "object",
  "required": ["schema", "version", "name", "frameCount", "interpolation", "suppress", "normalize", "keyframes"],
  "properties": {
    "schema": {"const": "morph-lab"},
    "version": {"const": 1},
    "name": {"type": "string", "maxLength": 80},
    "frameCount": {"enum": [16, 64, 256]},
    "interpolation": {"enum": ["linear", "cosine", "hermite"]},
    "suppress": {"type": "boolean", "description": "Apply Lanczos sigma factors during rendering"},
    "normalize": {"type": "boolean", "description": "One shared peak-normalization gain for the whole bank"},
    "keyframes": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "required": ["frame", "amplitudes", "phases"],
        "properties": {
          "frame": {"type": "integer", "minimum": 0, "maximum": 255},
          "amplitudes": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"type": "number", "minimum": 0, "maximum": 4}},
          "phases": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"type": "number", "minimum": -6.283185307179586, "maximum": 6.283185307179586}, "description": "Radians; index 0 is fundamental"}
        }
      }
    }
  },
  "$comment": "Runtime additionally enforces unique frame indices below frameCount and no more keyframes than frames; keyframes are sorted on import."
}
